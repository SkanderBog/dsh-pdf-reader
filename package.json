{
  "name": "dsh-pdf-reader",
  "version": "0.1.3",
  "type": "module",
  "description": "Page-aware PDF reading, search, visual crops and selective local OCR for DeepSeek Harness.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "ocr",
    "files",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "unknown"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-alpha.1": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.2.1-alpha.2": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      },
      "profiles": [
        "web",
        "desktop",
        "custom"
      ]
    },
    "pluginType": "feature"
  },
  "scripts": {
    "test": "node test/reader.test.mjs",
    "check": "node --check src/index.mjs && node --check src/document.mjs && node --check src/process.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:profile": "node scripts/check-profile.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkanderBog/dsh-pdf-reader.git"
  },
  "homepage": "https://github.com/SkanderBog/dsh-pdf-reader#readme",
  "bugs": {
    "url": "https://github.com/SkanderBog/dsh-pdf-reader/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.0-rc.2",
    "sharp": "0.35.5"
  }
}
